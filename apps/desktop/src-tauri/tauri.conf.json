{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ariadne",
  "version": "0.2.0",
  "identifier": "io.github.mgilardi.ariadne",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Ariadne", "width": 1040, "height": 720, "minWidth": 760, "minHeight": 520, "visible": false }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../../../tools/*.py": "engine/tools/",
      "../../../bin/ariadne": "engine/bin/ariadne",
      "../../../commands/*": "engine/commands/",
      "../../../templates/*": "engine/templates/",
      "../../../RULES.md": "engine/RULES.md"
    },
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-", "hardenedRuntime": false, "entitlements": "Entitlements.plist" }
  }
}
